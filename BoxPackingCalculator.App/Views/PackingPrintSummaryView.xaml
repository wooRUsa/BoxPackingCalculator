<UserControl x:Class="BoxPackingCalculator.App.Views.PackingPrintSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>


        <!-- 전체 합계 -->
        <Border
            Margin="0,0,0,28"
            Padding="18"
            BorderBrush="#CFCFCF"
            BorderThickness="1"
            Background="#F7F7F7"
            CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="28"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="28"/>

                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- 제목 -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="전체 합계"
                        FontSize="20"
                        FontWeight="Bold"/>

                    <TextBlock
                        Margin="0,4,0,0"
                        Text="중량은 완박스만 포함하며 혼합박스의 예상 중량은 제외됩니다."
                        FontSize="11"
                        Foreground="Gray"
                        TextWrapping="Wrap"/>

                </StackPanel>


                <!-- 완박스 총 개수 -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="완박스 총 개수"
                        FontSize="11"
                        Foreground="Gray"
                        HorizontalAlignment="Right"/>

                    <StackPanel
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <TextBlock
                            Text="{Binding OverallFullBoxCount}"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock
                            Margin="4,0,0,0"
                            Text="개"
                            FontSize="14"
                            VerticalAlignment="Bottom"/>

                    </StackPanel>

                </StackPanel>


                <!-- 완박스 총중량 -->
                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="완박스 총중량"
                        FontSize="11"
                        Foreground="Gray"
                        HorizontalAlignment="Right"/>

                    <StackPanel
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <TextBlock
                            Text="{Binding OverallFullBoxWeightKg,
                                           StringFormat={}{0:0.##}}"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock
                            Margin="4,0,0,0"
                            Text="kg"
                            FontSize="14"
                            VerticalAlignment="Bottom"/>

                    </StackPanel>

                </StackPanel>


                <!-- 예상 혼합박스 개수 -->
                <StackPanel
                    Grid.Column="5"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="예상 혼합박스 개수"
                        FontSize="11"
                        Foreground="Gray"
                        HorizontalAlignment="Right"/>

                    <StackPanel
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <TextBlock
                            Text="{Binding OverallMixedBoxCount}"
                            FontSize="20"
                            FontWeight="Bold"/>

                        <TextBlock
                            Margin="4,0,0,0"
                            Text="개"
                            FontSize="14"
                            VerticalAlignment="Bottom"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>


        <!-- 혼합박스 상세 제목 -->
        <TextBlock
            Text="혼합박스 상세"
            FontSize="20"
            FontWeight="Bold"/>

        <TextBlock
            Margin="0,4,0,12"
            Text="잔량을 같은 규격 박스에 혼합하는 예상 포장안입니다. 실제 포장 가능 여부와 중량은 작업자가 확인해주세요."
            FontSize="11"
            Foreground="Gray"
            TextWrapping="Wrap"/>


        <!-- 혼합박스 상세 목록 -->
        <DataGrid
            ItemsSource="{Binding MixedBoxResults}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="혼합박스"
                    Binding="{Binding BoxTitle}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="박스 규격"
                    Binding="{Binding BoxDisplaySize}"
                    Width="105"/>

                <DataGridTextColumn
                    Header="제품 구성"
                    Binding="{Binding ItemSummary}"
                    Width="300">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">

                            <Setter
                                Property="TextWrapping"
                                Value="Wrap"/>

                            <Setter
                                Property="VerticalAlignment"
                                Value="Center"/>

                        </Style>
                    </DataGridTextColumn.ElementStyle>

                </DataGridTextColumn>

                <DataGridTextColumn
                    Header="점유율"
                    Binding="{Binding OccupancyPercent,
                                      StringFormat={}{0:0.#}%}"
                    Width="80"/>

                <DataGridTextColumn
                    Header="예상 중량"
                    Binding="{Binding EstimatedWeightKg,
                                      StringFormat={}{0:0.##} kg}"
                    Width="95"/>

            </DataGrid.Columns>

        </DataGrid>

    </StackPanel>

</UserControl>