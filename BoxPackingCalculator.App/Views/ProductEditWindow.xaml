<Window x:Class="BoxPackingCalculator.App.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="제품 등록"
        Width="520"
        Height="430"
        MinWidth="480"
        MinHeight="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- 제목 -->
        <StackPanel Grid.Row="0">

            <TextBlock
                Text="제품 정보"
                FontSize="24"
                FontWeight="Bold"/>

            <TextBlock
                Margin="0,6,0,0"
                Text="제품의 포장 마스터 정보를 입력해주세요."
                FontSize="13"
                Foreground="Gray"/>

        </StackPanel>


        <!-- 제품명 -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="제품명"
                FontSize="14"
                VerticalAlignment="Center"/>

            <TextBox
                Grid.Column="1"
                Height="34"
                Padding="8,5"
                Text="{Binding ProductName,
                   UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>


        <!-- 박스 규격 -->
        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="박스 규격"
                FontSize="14"
                VerticalAlignment="Center"/>

            <ComboBox
                Grid.Column="1"
                Height="34"
                Padding="8,4"
                ItemsSource="{Binding BoxOptions}"
                SelectedItem="{Binding SelectedBoxOption, Mode=TwoWay}"
                DisplayMemberPath="DisplayText"/>

        </Grid>


        <!-- 입수량 -->
        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="입수량 (개/BOX)"
                FontSize="14"
                VerticalAlignment="Center"/>

            <TextBox
                Grid.Column="1"
                Height="34"
                Padding="8,5"
                IsEnabled="{Binding IsPackingFieldsEnabled}"
                Text="{Binding CapacityPerBoxText,
                   UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>


        <!-- 완박스 무게 -->
        <Grid Grid.Row="8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="완박스 무게 (kg)"
                FontSize="14"
                VerticalAlignment="Center"/>

            <TextBox
                Grid.Column="1"
                Height="34"
                Padding="8,5"
                IsEnabled="{Binding IsPackingFieldsEnabled}"
                Text="{Binding FullBoxWeightKgText,
                   UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>


        <!-- 하단 버튼 -->
        <Grid Grid.Row="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                Height="36"
                Content="취소"
                IsCancel="True"/>

            <Button
                Grid.Column="3"
                Height="36"
                Content="저장"
                FontWeight="SemiBold"
                Click="SaveButton_Click"/>

        </Grid>

    </Grid>

</Window>