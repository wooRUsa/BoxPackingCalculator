<Window x:Class="BoxPackingCalculator.App.Views.BoxEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="박스 등록"
        Width="500"
        Height="480"
        MinWidth="460"
        MinHeight="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>

            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- 제목 -->
        <StackPanel Grid.Row="0">

            <TextBlock
                Text="박스 정보"
                FontSize="24"
                FontWeight="Bold"/>

            <TextBlock
                Margin="0,6,0,0"
                Text="박스의 가로, 세로, 높이를 입력해주세요."
                FontSize="13"
                Foreground="Gray"/>

        </StackPanel>


        <!-- 가로 -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="가로"
                FontSize="14"
                VerticalAlignment="Center"/>

            <TextBox
                Grid.Column="1"
                Height="34"
                Padding="8,5"
                Text="{Binding WidthText,
                   UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>


        <!-- 세로 -->
        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="세로"
                FontSize="14"
                VerticalAlignment="Center"/>

            <TextBox
                Grid.Column="1"
                Height="34"
                Padding="8,5"
                Text="{Binding DepthText,
                   UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>


        <!-- 높이 -->
        <Grid Grid.Row="6">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="높이"
                FontSize="14"
                VerticalAlignment="Center"/>

            <TextBox
                Grid.Column="1"
                Height="34"
                Padding="8,5"
                Text="{Binding HeightText,
                   UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>


        <!-- 안내 -->
        <Border
            Grid.Row="8"
            Padding="12"
            Background="#F5F5F5"
            CornerRadius="4">

            <StackPanel>

                <TextBlock
                    Text="박스 ID는 입력한 규격을 기준으로 자동 생성됩니다."
                    FontSize="12"
                    Foreground="DimGray"/>

                <TextBlock
                    Margin="0,4,0,0"
                    Text="가로와 세로는 자동 정규화되므로 51×50×53과 50×51×53은 같은 박스로 처리됩니다."
                    FontSize="12"
                    Foreground="DimGray"
                    TextWrapping="Wrap"/>

            </StackPanel>

        </Border>


        <!-- 하단 버튼 -->
        <Grid Grid.Row="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                Height="36"
                Content="취소"
                IsCancel="True"/>

            <Button
                Grid.Column="3"
                Height="36"
                Content="저장"
                FontWeight="SemiBold"
                Click="SaveButton_Click"/>

        </Grid>

    </Grid>

</Window>