<Window x:Class="BoxPackingCalculator.App.Views.MasterManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="마스터 관리"
        Width="1000"
        Height="700"
        MinWidth="850"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- 제목 -->
        <StackPanel Grid.Row="0">

            <TextBlock
                Text="마스터 관리"
                FontSize="28"
                FontWeight="Bold" />

            <TextBlock
                Margin="0,6,0,0"
                Text="제품 및 박스 마스터를 등록, 수정, 삭제할 수 있습니다."
                FontSize="14"
                Foreground="Gray" />

        </StackPanel>


        <!-- 관리 탭 -->
        <TabControl Grid.Row="2">


            <!-- 제품 관리 -->
            <TabItem Header="제품 관리">

                <Grid Margin="16">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    
                    <!-- 제품 관리 제목 + 버튼 -->
                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- 왼쪽 제목 -->
                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Text="제품 마스터"
                                FontSize="20"
                                FontWeight="Bold"/>

                            <TextBlock
                                Margin="0,4,0,0"
                                Text="현재 등록된 제품과 포장 사양입니다."
                                FontSize="13"
                                Foreground="Gray"/>

                        </StackPanel>


                        <!-- 오른쪽 버튼 영역 -->
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">

                            <TextBlock
                                Margin="0,0,20,0"
                                Text="{Binding Products.Count,
                           StringFormat=등록 제품: {0}개}"
                                FontSize="13"
                                Foreground="Gray"
                                VerticalAlignment="Center"/>


                            <Button
                                Width="100"
                                Height="32"
                                Margin="0,0,8,0"
                                Content="신규 등록"
                                Click="AddProductButton_Click"/>


                            <Button
                                Width="100"
                                Height="32"
                                Margin="0,0,8,0"
                                Content="선택 수정"
                                Click="EditProductButton_Click"/>


                            <Button
                                Width="100"
                                Height="32"
                                Content="선택 삭제"
                                Click="DeleteProductButton_Click"/>

                        </StackPanel>

                    </Grid>


                    <!-- 제품 목록 -->
                    <DataGrid
                        Grid.Row="2"
                        ItemsSource="{Binding Products}"
                        SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        SelectionMode="Single">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="제품 ID"
                                Binding="{Binding ProductId}"
                                Width="90"/>

                            <DataGridTextColumn
                                Header="제품명"
                                Binding="{Binding ProductName}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="박스 규격"
                                Binding="{Binding BoxDisplaySize}"
                                Width="130"/>

                            <DataGridTextColumn
                                Header="입수량"
                                Binding="{Binding CapacityPerBoxDisplay}"
                                Width="90"/>

                            <DataGridTextColumn
                                Header="완박스 무게"
                                Binding="{Binding FullBoxWeightKgDisplay}"
                                Width="120"/>

                            <DataGridTextColumn
                                Header="포장 정보 상태"
                                Binding="{Binding PackingInfoStatus}"
                                Width="170"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </TabItem>


<!-- 박스 관리 -->
<TabItem Header="박스 관리">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- 박스 관리 제목 + 버튼 -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- 왼쪽 제목 -->
            <StackPanel Grid.Column="0">

                <TextBlock
                    Text="박스 마스터"
                    FontSize="20"
                    FontWeight="Bold"/>

                <TextBlock
                    Margin="0,4,0,0"
                    Text="현재 등록된 박스 규격입니다."
                    FontSize="13"
                    Foreground="Gray"/>

            </StackPanel>


            <!-- 오른쪽 버튼 영역 -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Bottom">

                <TextBlock
                    Margin="0,0,20,0"
                    Text="{Binding Boxes.Count,
                           StringFormat=등록 박스: {0}개}"
                    FontSize="13"
                    Foreground="Gray"
                    VerticalAlignment="Center"/>


                <Button
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="신규 등록"
                    Click="AddBoxButton_Click"/>


                <Button
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="선택 수정"
                    Click="EditBoxButton_Click"/>


                <Button
                    Width="100"
                    Height="32"
                    Content="선택 삭제"
                    Click="DeleteBoxButton_Click"/>

            </StackPanel>

        </Grid>


        <!-- 박스 목록 -->
        <DataGrid
            Grid.Row="2"
            ItemsSource="{Binding Boxes}"
            SelectedItem="{Binding SelectedBox, Mode=TwoWay}"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal"
            SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="박스 ID"
                    Binding="{Binding Id}"
                    Width="220"/>

                <DataGridTextColumn
                    Header="박스 규격"
                    Binding="{Binding DisplaySize}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="가로"
                    Binding="{Binding Width}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="세로"
                    Binding="{Binding Depth}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="높이"
                    Binding="{Binding Height}"
                    Width="100"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</TabItem>

        </TabControl>

    </Grid>

</Window>