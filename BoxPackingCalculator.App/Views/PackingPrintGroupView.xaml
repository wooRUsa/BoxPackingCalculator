<UserControl x:Class="BoxPackingCalculator.App.Views.PackingPrintGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        박스 규격 하나의 인쇄 카드.
        페이지 분할 시 이 컨트롤 하나를 통째로
        현재 페이지 또는 다음 페이지에 배치한다.
    -->
    <Border
        Margin="0,0,0,20"
        Padding="18"
        BorderBrush="#BFBFBF"
        BorderThickness="1"
        CornerRadius="4">

        <StackPanel>

            <!-- 박스 규격 -->
            <TextBlock
                Text="{Binding BoxDisplaySize}"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,14"/>


            <!-- 제품 목록 -->
            <DataGrid
                ItemsSource="{Binding Products}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                EnableRowVirtualization="False"
                EnableColumnVirtualization="False">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="제품명"
                        Binding="{Binding ProductName}"
                        Width="220">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter
                                    Property="TextWrapping"
                                    Value="Wrap"/>

                                <Setter
                                    Property="VerticalAlignment"
                                    Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>

                    <DataGridTextColumn
                        Header="주문 수량"
                        Binding="{Binding OrderQuantity}"
                        Width="85"/>

                    <DataGridTextColumn
                        Header="수량 단위"
                        Binding="{Binding CapacityPerBoxDisplay}"
                        Width="85"/>

                    <DataGridTextColumn
                        Header="완박스"
                        Binding="{Binding FullBoxCountDisplay}"
                        Width="75"/>

                    <DataGridTextColumn
                        Header="완박스 중량"
                        Binding="{Binding FullBoxTotalWeightDisplay}"
                        Width="110"/>

                    <DataGridTextColumn
                        Header="잔량"
                        Binding="{Binding RemainingQuantityDisplay}"
                        Width="65"/>

                </DataGrid.Columns>

            </DataGrid>


            <!-- 규격별 소계 + 수기 메모 -->
            <Border
                Margin="0,14,0,0"
                Padding="14"
                BorderBrush="#D0D0D0"
                BorderThickness="1">

                <StackPanel>

                    <!-- 소계 -->
                    <WrapPanel
                        Margin="0,0,0,12">
                        
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter
                                    Property="Visibility"
                                    Value="Visible"/>

                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding HasPackingSummary}"
                                        Value="False">

                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed"/>

                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        
                        <TextBlock
                            Text="규격별 소계"
                            FontWeight="Bold"
                            Margin="0,0,28,0"/>


                        <TextBlock Text="완박스 "/>

                        <TextBlock
                            Text="{Binding TotalFullBoxCount}"
                            FontWeight="Bold"/>

                        <TextBlock
                            Text="개"
                            Margin="0,0,22,0"/>


                        <TextBlock Text="완박스 총중량 "/>

                        <TextBlock
                            Text="{Binding TotalFullBoxWeightKg,
                                           StringFormat={}{0:0.##}}"
                            FontWeight="Bold"/>

                        <TextBlock Text=" kg"/>

                    </WrapPanel>


                    <!-- 수기 메모 공간 -->
                    <TextBlock
                        Text="메모"
                        FontSize="12"
                        Foreground="Gray"
                        Margin="0,0,0,4"/>

                    <Border
                        Height="{Binding MemoHeight}"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Border>

</UserControl>