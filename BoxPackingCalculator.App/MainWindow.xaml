<Window x:Class="BoxPackingCalculator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="포장 계산기"
        Width="1000"
        Height="800"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="Manual">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="24">
            
            <!-- 제목 -->
            <Grid Margin="0,0,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="제품 포장 계산기"
                        FontSize="28"
                        FontWeight="Bold"/>

                    <TextBlock
                        Margin="0,8,0,0"
                        Text="제품을 검색하고 주문 수량을 입력한 뒤 포장 계획을 계산하세요."
                        FontSize="14"
                        Foreground="Gray"/>

                </StackPanel>


                <Button
                    Grid.Column="1"
                    Height="38"
                    Content="마스터 관리"
                    FontSize="14"
                    VerticalAlignment="Top"
                    Click="MasterManagementButton_Click"/>

            </Grid>
            
            <!-- 출하 정보 -->
            <Grid Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Text="제품 행선지"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    Grid.Column="1"
                    Height="36"
                    Padding="8,5"
                    FontSize="14"
                    VerticalContentAlignment="Center"
                    Text="{Binding ShippingDestination,
                       UpdateSourceTrigger=PropertyChanged}"/>


                <TextBlock
                    Grid.Column="3"
                    Margin="0,0,10,0"
                    Text="인보이스 번호"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    Grid.Column="4"
                    Height="36"
                    Padding="8,5"
                    FontSize="14"
                    VerticalContentAlignment="Center"
                    Text="{Binding InvoiceNumber,
                       UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>

            <!-- 검색 -->
            <Grid Margin="0,0,0,12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Height="42"
                    Padding="12,8"
                    FontSize="16"
                    VerticalContentAlignment="Center"
                    Text="{Binding SearchKeyword,
                                   UpdateSourceTrigger=PropertyChanged}"/>

                <Button
                    Grid.Column="2"
                    Height="42"
                    Content="주문에 추가"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Command="{Binding AddOrderCommand}"/>

            </Grid>


            <!-- 검색 결과 -->
            <Border
                Height="160"
                Margin="0,0,0,24"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6">

                <ListBox
                    ItemsSource="{Binding SearchResults}"
                    SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                    BorderThickness="0">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid Margin="12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding ProductName}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding BoxDisplaySize}"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding CapacityPerBox,
                                                   StringFormat={}{0}개/BOX}"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding FullBoxWeightKg,
                                                   StringFormat={}{0:0.##} kg}"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Border>

            
            <!-- 주문 목록 제목 -->
            <Grid Margin="0,0,0,12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>


                <TextBlock
                    Grid.Column="0"
                    Text="주문 목록"
                    FontSize="20"
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>


                <Button
                    Grid.Column="1"
                    Height="34"
                    Content="선택 삭제"
                    Command="{Binding RemoveOrderCommand}"/>


                <Button
                    Grid.Column="3"
                    Height="34"
                    Content="전체 초기화"
                    Command="{Binding ResetCommand}"/>


                <Button
                    Grid.Column="5"
                    Height="34"
                    Content="포장 계산"
                    FontWeight="SemiBold"
                    Command="{Binding CalculatePackingCommand}"/>


                <Button
                    Grid.Column="7"
                    Height="34"
                    Content="인쇄 미리보기"
                    Click="PrintPreviewButton_Click"/>

            </Grid>


            <!-- 주문 목록 -->
            <DataGrid
                Height="180"
                Margin="0,0,0,24"
                ItemsSource="{Binding OrderItems}"
                SelectedItem="{Binding SelectedOrderItem, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="제품명"
                        Binding="{Binding ProductName}"
                        Width="*"
                        IsReadOnly="True"/>

                    <DataGridTextColumn
                        Header="박스 규격"
                        Binding="{Binding BoxDisplaySize}"
                        Width="140"
                        IsReadOnly="True"/>

                    <DataGridTextColumn
                        Header="입수량"
                        Binding="{Binding CapacityPerBox}"
                        Width="100"
                        IsReadOnly="True"/>

                    <DataGridTextColumn
                        Header="완박스 무게"
                        Binding="{Binding FullBoxWeightKg}"
                        Width="120"
                        IsReadOnly="True"/>

                    <DataGridTextColumn
                        Header="주문 수량"
                        Binding="{Binding Quantity,
                          UpdateSourceTrigger=PropertyChanged}"
                        Width="120"/>

                </DataGrid.Columns>

            </DataGrid>


            <!-- 박스 규격별 결과 -->
            <Grid Margin="0,0,0,12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="포장 계산 결과"
                    FontSize="20"
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>

                <TextBlock
                    Grid.Column="2"
                    Text="{Binding PackingStatus}"
                    FontSize="13"
                    Foreground="DarkOrange"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"/>

            </Grid>

<!-- 새 박스 규격별 포장 결과 -->
<ItemsControl
    Margin="0,0,0,24"
    ItemsSource="{Binding BoxResultGroups}">

    <ItemsControl.ItemTemplate>

        <DataTemplate>

            <Border
                Margin="0,0,0,16"
                Padding="16"
                BorderBrush="#D8D8D8"
                BorderThickness="1"
                CornerRadius="6">

                <StackPanel>

                    <!-- 박스 규격 제목 -->
                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="{Binding BoxDisplaySize}"
                            FontSize="20"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="박스 규격"
                            FontSize="12"
                            Foreground="Gray"
                            VerticalAlignment="Center"/>

                    </Grid>


                    <!-- 해당 박스 규격을 사용하는 제품들 -->
                    <DataGrid
                        ItemsSource="{Binding Products}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="제품명"
                                Binding="{Binding ProductName}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="주문 수량"
                                Binding="{Binding OrderQuantity}"
                                Width="110"/>

                            <DataGridTextColumn
                                Header="수량 단위"
                                Binding="{Binding CapacityPerBoxDisplay}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="완박스"
                                Binding="{Binding FullBoxCountDisplay}"
                                Width="100"/>

                            <DataGridTextColumn
                                Header="완박스 중량"
                                Binding="{Binding FullBoxTotalWeightDisplay}"
                                Width="130"/>

                            <DataGridTextColumn
                                Header="잔량"
                                Binding="{Binding RemainingQuantityDisplay}"
                                Width="100"/>

                        </DataGrid.Columns>

                    </DataGrid>
                    
                    <!-- 박스 규격별 소계 -->
<Border
    Margin="0,12,0,0"
    Padding="12"
    Background="#F5F5F5"
    CornerRadius="4">

    <Border.Style>
        <Style TargetType="Border">
            <Setter
                Property="Visibility"
                Value="Visible"/>

            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding HasPackingSummary}"
                    Value="False">

                    <Setter
                        Property="Visibility"
                        Value="Collapsed"/>

                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>


        <TextBlock
            Grid.Column="0"
            Text="규격별 소계"
            FontWeight="Bold"
            VerticalAlignment="Center"/>


        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal">

            <TextBlock
                Text="완박스 "
                Foreground="Gray"/>

            <TextBlock
                Text="{Binding TotalFullBoxCount}"
                FontWeight="SemiBold"/>

            <TextBlock Text="개"/>

        </StackPanel>


        <StackPanel
            Grid.Column="3"
            Orientation="Horizontal">

            <TextBlock
                Text="혼합박스 "
                Foreground="Gray"/>

            <TextBlock
                Text="{Binding MixedBoxCount}"
                FontWeight="SemiBold"/>

            <TextBlock Text="개"/>

        </StackPanel>


        <StackPanel
            Grid.Column="5"
            Orientation="Horizontal">

            <TextBlock
                Text="총 박스 "
                Foreground="Gray"/>

            <TextBlock
                Text="{Binding TotalBoxCount}"
                FontWeight="SemiBold"/>

            <TextBlock Text="개"/>

        </StackPanel>


        <StackPanel
            Grid.Column="7"
            Orientation="Horizontal">

            <TextBlock
                Text="완박스 총중량 "
                Foreground="Gray"/>

            <TextBlock
                Text="{Binding TotalFullBoxWeightKg,
                               StringFormat={}{0:0.##}}"
                FontWeight="SemiBold"/>

            <TextBlock Text=" kg"/>

        </StackPanel>

    </Grid>

</Border>

                </StackPanel>

            </Border>

        </DataTemplate>

    </ItemsControl.ItemTemplate>

</ItemsControl>
            
            <!-- 전체 포장 합계 -->
<Border
    Margin="0,0,0,28"
    Padding="18"
    BorderBrush="#CFCFCF"
    BorderThickness="1"
    Background="#F7F7F7"
    CornerRadius="6">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="40"/>

            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="40"/>

            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>


        <!-- 제목 -->
        <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center">

            <TextBlock
                Text="전체 합계"
                FontSize="20"
                FontWeight="Bold"/>

            <TextBlock
                Margin="0,4,0,0"
                Text="중량은 완박스만 포함하며 혼합박스의 예상 중량은 제외됩니다."
                FontSize="12"
                Foreground="Gray"/>

        </StackPanel>


        <!-- 완박스 총 개수 -->
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center">

            <TextBlock
                Text="완박스 총 개수"
                FontSize="12"
                Foreground="Gray"
                HorizontalAlignment="Right"/>

            <StackPanel
                Margin="0,4,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <TextBlock
                    Text="{Binding OverallFullBoxCount}"
                    FontSize="22"
                    FontWeight="Bold"/>

                <TextBlock
                    Margin="4,0,0,0"
                    Text="개"
                    FontSize="16"
                    VerticalAlignment="Bottom"/>

            </StackPanel>

        </StackPanel>


        <!-- 완박스 총중량 -->
        <StackPanel
            Grid.Column="3"
            VerticalAlignment="Center">

            <TextBlock
                Text="완박스 총중량"
                FontSize="12"
                Foreground="Gray"
                HorizontalAlignment="Right"/>

            <StackPanel
                Margin="0,4,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <TextBlock
                    Text="{Binding OverallFullBoxWeightKg,
                                   StringFormat={}{0:0.##}}"
                    FontSize="22"
                    FontWeight="Bold"/>

                <TextBlock
                    Margin="4,0,0,0"
                    Text="kg"
                    FontSize="16"
                    VerticalAlignment="Bottom"/>

            </StackPanel>

        </StackPanel>


        <!-- 예상 혼합박스 개수 -->
        <StackPanel
            Grid.Column="5"
            VerticalAlignment="Center">

            <TextBlock
                Text="예상 혼합박스 개수"
                FontSize="12"
                Foreground="Gray"
                HorizontalAlignment="Right"/>

            <StackPanel
                Margin="0,4,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <TextBlock
                    Text="{Binding OverallMixedBoxCount}"
                    FontSize="22"
                    FontWeight="Bold"/>

                <TextBlock
                    Margin="4,0,0,0"
                    Text="개"
                    FontSize="16"
                    VerticalAlignment="Bottom"/>

            </StackPanel>

        </StackPanel>

    </Grid>

</Border>

            <!-- 혼합박스 상세 -->
            <TextBlock
                Text="혼합박스 상세"
                FontSize="20"
                FontWeight="Bold"/>

            <TextBlock
                Margin="0,4,0,12"
                Text="잔량을 같은 규격 박스에 혼합하는 예상 포장안입니다. 실제 포장 가능 여부와 중량은 작업자가 확인해주세요."
                FontSize="12"
                Foreground="Gray"/>

            <DataGrid
                Height="160"
                Margin="0,0,0,24"
                ItemsSource="{Binding MixedBoxResults}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="혼합박스"
                        Binding="{Binding BoxTitle}"
                        Width="130"/>

                    <DataGridTextColumn
                        Header="박스 규격"
                        Binding="{Binding BoxDisplaySize}"
                        Width="130"/>

                    <DataGridTextColumn
                        Header="제품 구성"
                        Binding="{Binding ItemSummary}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="점유율"
                        Binding="{Binding OccupancyPercent,
                                          StringFormat={}{0:0.#}%}"
                        Width="100"/>

                    <DataGridTextColumn
                        Header="예상 중량"
                        Binding="{Binding EstimatedWeightKg,
                                          StringFormat={}{0:0.##} kg}"
                        Width="120"/>

                </DataGrid.Columns>

            </DataGrid>

        </StackPanel>

    </ScrollViewer>

</Window>